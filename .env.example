# PostgreSQL, e.g. postgres://cue:STRONG_PASSWORD@127.0.0.1:5432/cue
DATABASE_URL=
APP_TIMEZONE=Asia/Kolkata
# Public address, used for links in Telegram messages
APP_URL=https://cue.creativheads.com
# Set to true only while testing over plain http (no HTTPS)
INSECURE_COOKIES=false

# Scheduled jobs: the scheduler sends this as a Bearer token to /api/cron/<job>
CRON_SECRET=

# Instagram data via Windsor.ai (Phase 2/5). Story field names: confirm in Windsor's field list.
WINDSOR_API_KEY=
# WINDSOR_STORY_FIELDS=account_id,story_id,story_timestamp,story_permalink,story_reach,story_media_type

# Telegram (Phase 3). Send-only works with any bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Only for a bot no other app uses: enables /start linking and tap-to-approve buttons.
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
